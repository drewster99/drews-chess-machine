 50.7, 2.012], [557.5, 1666.4, 51.5, 1.953], [558.5, 1667.4, 51.5, 1.975], [559.5, 1707.6, 53.3, 1.977], [560.5, 1673.1, 51.7, 1.922], [561.5, 1727.7, 54.1, 1.861], [562.5, 1641.7, 50.4, 2.010], [563.5, 1673.6, 51.8, 1.944], [564.5, 1698.3, 52.9, 1.974], [565.5, 1705.5, 53.2, 1.912], [566.5, 1682.9, 52.2, 2.019], [567.5, 1694.2, 52.7, 1.932]];
const SEAM=268.5;

const CSS=getComputedStyle(document.documentElement);
const col=n=>CSS.getPropertyValue(n).trim();
const reduce=matchMedia("(prefers-reduced-motion:reduce)").matches;

// EMA helper (span N -> alpha=2/(N+1)), seeded with first value
function ema(vals,N){const a=2/(N+1);let e=vals[0];return vals.map((v,i)=>{e=i?a*v+(1-a)*e:v;return e;});}
const EMA_PE = ema(D.map(d=>d[1]),10);
const EMA_T1 = ema(D.map(d=>d[2]),10);
const EMA_NLL= ema(D.map(d=>d[3]),10);

// KPIs
const last=D[D.length-1], best=D.reduce((a,b)=>b[1]>a[1]?b:a);
const mean=D.reduce((s,d)=>s+d[1],0)/D.length;
const emaNow=EMA_PE[EMA_PE.length-1];
const dfmt=v=>(v>=0?"+":"")+v.toFixed(0);
const kd=[
  ["v5 baseline",BASE.pElo.toFixed(0),null],
  ["latest EMA",emaNow.toFixed(0),emaNow-BASE.pElo],
  ["latest · "+last[0]+"k",last[1].toFixed(0),last[1]-BASE.pElo],
  ["best · step"+best[0]+"k",best[1].toFixed(0),best[1]-BASE.pElo],
  ["mean · "+D.length+" ckpts",mean.toFixed(0),mean-BASE.pElo],
];
document.getElementById("kpis").innerHTML=kd.map(k=>{
  const dl=k[2]==null?'<div class="delta">&nbsp;</div>':`<div class="delta ${k[2]>=0?'up':'down'}">${dfmt(k[2])} vs base</div>`;
  return `<div class="kpi"><div class="lab">${k[0]}</div>
    <div class="val">${k[1]} <small>pElo</small></div>${dl}</div>`;
}).join("");
document.getElementById("foot").textContent=
  D.length+" checkpoints · steps 1k–"+last[0]+"k (cumulative) · wide battery n=4435 · reboot seam 268.5k · records pElo 1770@538.5k, nll 1.8445@536.5k · 10-pt EMA α=0.182";

function chart(cv,tipEl,o){
  const dpr=Math.max(1,window.devicePixelRatio||1);
  const W=cv.clientWidth,H=cv.height; cv.width=W*dpr; cv.height=H*dpr;
  const g=cv.getContext("2d"); g.scale(dpr,dpr);
  const m={l:52,r:o.right?52:16,t:14,b:26};
  const px=s=>m.l+(s-0)/(o.xmax-0)*(W-m.l-m.r);
  const L=o.left,R=o.right;
  const pyL=v=>m.t+(L.max-v)/(L.max-L.min)*(H-m.t-m.b);
  const pyR=v=>m.t+(R.max-v)/(R.max-R.min)*(H-m.t-m.b); // normal (low nll at bottom)

  function line(arr,idxOrEma,yfn,color,w,alpha,clip){
    g.beginPath(); g.strokeStyle=color; g.lineWidth=w; g.globalAlpha=alpha; g.lineJoin="round";
    D.forEach((d,i)=>{ if(i>clip)return; const x=px(d[0]);
      const val = typeof idxOrEma==="number" ? d[idxOrEma] : idxOrEma[i];
      const y=yfn(val); i?g.lineTo(x,y):g.moveTo(x,y);});
    g.stroke(); g.globalAlpha=1;
  }
  function draw(prog){
    g.clearRect(0,0,W,H);
    g.font="11px "+col("--mono"); g.textBaseline="middle";
    g.strokeStyle=col("--hair"); g.lineWidth=1;
    for(let i=0;i<=L.ticks;i++){ const v=L.min+(L.max-L.min)*i/L.ticks,y=pyL(v);
      g.beginPath();g.moveTo(m.l,y);g.lineTo(W-m.r,y);g.stroke();
      g.fillStyle=col("--muted");g.textAlign="right";g.fillText(L.fmt(v),m.l-8,y);}
    if(R){g.fillStyle=col("--nll");g.textAlign="left";
      for(let i=0;i<=R.ticks;i++){const v=R.min+(R.max-R.min)*i/R.ticks;g.fillText(v.toFixed(2),W-m.r+8,pyR(v));}}
    g.fillStyle=col("--muted");g.textAlign="center";g.textBaseline="top";
    for(let s=0;s<=o.xmax;s+=20){g.fillText(s+"k",px(s),H-m.b+7);}
    // reboot seam
    g.strokeStyle=col("--faint");g.setLineDash([2,4]);g.lineWidth=1;
    g.beginPath();g.moveTo(px(SEAM),m.t);g.lineTo(px(SEAM),H-m.b);g.stroke();g.setLineDash([]);
    // baseline
    g.strokeStyle=col("--base");g.setLineDash([5,4]);g.lineWidth=1.4;
    const yb=pyL(o.baseline);g.beginPath();g.moveTo(m.l,yb);g.lineTo(W-m.r,yb);g.stroke();g.setLineDash([]);
    const clip=Math.floor((D.length-1)*prog);
    // right EMA (nll) thin
    if(R) line(EMA_NLL,EMA_NLL,pyR,col("--nll"),1.7,.85,clip);
    // raw left thin
    line(D,L.idx,pyL,col(L.rawColor),1.2,1,clip);
    // EMA left bold
    line(D,L.ema,pyL,col(L.color),2.8,1,clip);
    // endpoint dot on EMA
    const e=Math.min(clip,D.length-1);
    g.fillStyle=col(L.color);g.beginPath();g.arc(px(D[e][0]),pyL(L.ema[e]),4,0,7);g.fill();
    g.strokeStyle=col("--ground");g.lineWidth=2;g.stroke();
  }
  cv.onmousemove=ev=>{const r=cv.getBoundingClientRect();const mx=ev.clientX-r.left;
    let bi=0,bd=1e9;D.forEach((d,i)=>{const dd=Math.abs(px(d[0])-mx);if(dd<bd){bd=dd;bi=i;}});
    const d=D[bi];tipEl.style.left=px(d[0])+"px";tipEl.style.top=pyL(L.ema[bi])+"px";tipEl.style.opacity=1;
    tipEl.innerHTML=o.tip(d,bi);};
  cv.onmouseleave=()=>tipEl.style.opacity=0;
  if(reduce)draw(1);
  else{let t0=null;(function a(ts){t0=t0||ts;const p=Math.min(1,(ts-t0)/1000);
    draw(p<1?1-Math.pow(1-p,3):1);if(p<1)requestAnimationFrame(a);})(requestAnimationFrame);}
}

function build(){
  chart(document.getElementById("c1"),document.getElementById("tip1"),{
    xmax:568,baseline:BASE.pElo,
    left:{idx:1,ema:EMA_PE,min:850,max:1800,ticks:8,color:"--pelo",rawColor:"--peloRaw",fmt:v=>v.toFixed(0)},
    right:{min:1.8,max:3.5,ticks:5},
    tip:(d,i)=>`<div class="r"><span class="k">step</span><span>${d[0]}k</span></div>
      <div class="r"><span class="k">pElo</span><span>${d[1].toFixed(0)} <span style="color:${d[1]>=BASE.pElo?'var(--pelo)':'var(--crater)'}">(${dfmt(d[1]-BASE.pElo)})</span></span></div>
      <div class="r"><span class="k">EMA</span><span style="color:var(--pelo)">${EMA_PE[i].toFixed(0)}</span></div>
      <div class="r"><span class="k">nll</span><span style="color:var(--nll)">${d[3].toFixed(3)}</span></div>`
  });
  chart(document.getElementById("c2"),document.getElementById("tip2"),{
    xmax:568,baseline:BASE.top1,
    left:{idx:2,ema:EMA_T1,min:18,max:57,ticks:6,color:"--top1",rawColor:"--top1",fmt:v=>v.toFixed(0)+"%"},
    right:null,
    tip:(d,i)=>`<div class="r"><span class="k">step</span><span>${d[0]}k</span></div>
      <div class="r"><span class="k">top1</span><span>${d[2].toFixed(1)}%</span></div>
      <div class="r"><span class="k">EMA</span><span style="color:var(--top1)">${EMA_T1[i].toFixed(1)}%</span></div>`
  });
}
build();
let rt;addEventListener("resize",()=>{clearTimeout(rt);rt=setTimeout(build,150);});
</script>
